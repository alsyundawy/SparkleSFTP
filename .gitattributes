# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source & Config Text Files
*.swift text eol=lf
*.h text eol=lf
*.m text eol=lf
*.c text eol=lf
*.modulemap text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.entitlements text eol=lf
*.plist text eol=lf
*.pbxproj text eol=lf

# Binary Assets
*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.ico binary
*.dmg binary
*.zip binary
*.pdf binary
